# ===================================================================
# RK International Language Academy - Environment Variables Blueprint
# ===================================================================

# MongoDB Connection (MongoDB Atlas free M0 cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rk_academy?retryWrites=true&w=majority

# Next.js Public URL
NEXT_PUBLIC_SITE_URL=https://rkacademy.lk

# Web3Forms Public Access Key (Free tier 250 submissions/mo for instant Gmail delivery)
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# Resend API Key (For branded student registration confirmation emails)
RESEND_API_KEY=re_your_resend_api_key_here

# Academy Admissions Contact Defaults
NEXT_PUBLIC_ACADEMY_PHONE=074 0224 355
NEXT_PUBLIC_ACADEMY_WHATSAPP=94740224355
ADMIN_EMAIL=rkacademykili@gmail.com

# Cloudinary (Free tier CDN for image optimization)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Admin Authentication
NEXTAUTH_SECRET=your_super_secret_auth_token_at_least_32_characters
NEXTAUTH_URL=http://localhost:3000
